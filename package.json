  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "24.8.1",
