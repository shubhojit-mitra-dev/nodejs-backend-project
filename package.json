    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "drizzle-orm": "^0.44.6",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "serverless-http": "^4.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "thundermail": "^2.0.0",
